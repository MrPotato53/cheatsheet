#!/bin/bash
# Unit tests before every commit (~15 s, no UI). The UI suite drives the real
# app and is run on request: ./test.sh full
#   Skip once:          git commit --no-verify
#   Turn the hook off:  git config --unset core.hooksPath
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "pre-commit: running unit tests"
./test.sh unit
